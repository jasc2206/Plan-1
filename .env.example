# Mientras no haya credenciales de broker, el sistema siempre opera en modo
# simulado (dry-run) contra un broker en memoria. Ninguna de estas variables
# es necesaria para correr el ciclo de dry-run.
DRY_RUN=true

# Opcional: si se define, el agente de decision usa Claude en vez de reglas simples
ANTHROPIC_API_KEY=

# Fase futura (todavia no soportado): broker real Alpaca (paper trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Fase futura (todavia no soportado): notificaciones por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Universo de acciones a analizar (separadas por coma)
STOCK_UNIVERSE=NVDA,MSFT,AAPL,GOOGL,AMZN,META,AVGO,TSLA,NFLX,AMD,CSCO,COST,ASML,MU,PLTR

# Parametros de screening
MIN_VOLUME=1000000
MIN_PRICE_CHANGE_PCT=2.0
MAX_CANDIDATES=5

# Parametros de riesgo (todo simulado en esta fase)
STARTING_CASH=100000
MAX_POSITION_PCT=0.10
MIN_CASH_RESERVE_PCT=0.20
MAX_DAILY_TRADES=5
