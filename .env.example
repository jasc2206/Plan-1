# Mientras no haya credenciales de broker, el sistema opera en modo
# simulado (dry-run) contra un broker en memoria. Ninguna de estas variables
# es necesaria para correr el ciclo de dry-run.
DRY_RUN=true

# Opcional: si se define, el agente de decision usa Claude en vez de reglas simples
ANTHROPIC_API_KEY=

# Si se definen ambas, el ciclo opera contra tu cuenta de Alpaca en modo
# PAPER TRADING (dinero simulado, nunca real). Se generan en
# https://app.alpaca.markets -> selecciona la cuenta "Paper Trading" -> API Keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Si se definen ambas, las notificaciones se envian por Telegram en vez de
# consola. Token: hablale a @BotFather en Telegram y usa /newbot.
# Chat ID: hablale a @userinfobot o usa https://api.telegram.org/bot<TOKEN>/getUpdates
# despues de enviarle un mensaje a tu bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Universo de instrumentos a analizar (separados por coma). Acciones van por
# su ticker normal; cripto necesita el sufijo -USD para que yfinance las
# resuelva (ej. XRP-USD, no XRP: "XRP" solo resuelve a un ETF distinto).
STOCK_UNIVERSE=NVDA,MSFT,AAPL,GOOGL,AMZN,META,AVGO,TSLA,NFLX,AMD,CSCO,COST,ASML,MU,PLTR,PAXG-USD,XRP-USD,SPCX

# Parametros de screening. El filtro de liquidez es en volumen de DOLARES
# (precio x volumen), no en unidades, para que sea comparable entre acciones
# y cripto (1M acciones no es lo mismo que 1M tokens).
MIN_DOLLAR_VOLUME=5000000
MIN_PRICE_CHANGE_PCT=2.0
MAX_CANDIDATES=5

# Parametros de riesgo (todo simulado en esta fase)
STARTING_CASH=100000
MAX_POSITION_PCT=0.10
MIN_CASH_RESERVE_PCT=0.20
MAX_DAILY_TRADES=5
